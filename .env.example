# Copy this file to .env and fill in real values before running docker-compose.
# Never commit the actual .env file.

# ---- PostgreSQL ----
# docker-compose runs a single Postgres container with three databases (identity_db,
# project_db, task_db) — one per service — created automatically by
# docker/postgres-init/00-init-all.sh on first start. This is the *superuser* password; the
# per-service least-privilege roles (svc_identity/svc_project/svc_task) get their own
# passwords from each service's database/migrations/002_role.sql (dev defaults — rotate them
# outside version control for anything beyond local learning/demo use).
POSTGRES_SUPERUSER_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# ---- RabbitMQ ----
# Must NOT be "guest" — RabbitMQ restricts the built-in guest account to loopback-only
# connections, which refuses every container-to-container login (not just remote hosts).
RABBITMQ_USER=taskflow
RABBITMQ_PASSWORD=taskflow_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---- Backend services ----
ASPNETCORE_ENVIRONMENT=Production
IDENTITY_PORT=5100
PROJECT_PORT=5200
TASK_PORT=5300

# ---- API Gateway (APISIX, standalone mode) ----
GATEWAY_PORT=9080

# ---- Frontend ----
FRONTEND_PORT=4200
# Baked into the Angular production build at `docker compose build` time. The frontend calls
# the gateway, never a service directly.
API_BASE_URL=http://localhost:9080/api
