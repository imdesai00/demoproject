# Copy this file to .env and fill in real values before running docker-compose.
# Never commit the actual .env file.

# ---- PostgreSQL ----
# This app does NOT run its own Postgres container. The backend container connects to
# PostgreSQL running on YOUR MACHINE (via host.docker.internal), so these values must
# match a database/user that already exist in your local Postgres instance.
# See the "Local PostgreSQL setup" section in README.md for the commands to create them.
POSTGRES_DB=taskmanager
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# ---- Backend (ASP.NET Core) ----
ASPNETCORE_ENVIRONMENT=Production
BACKEND_PORT=5000

# JWT signing key: use a long, random, high-entropy secret (32+ bytes) in real deployments.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_ISSUER=TaskManager
JWT_AUDIENCE=TaskManagerClient
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# ---- Frontend ----
FRONTEND_PORT=4200
# Baked into the Angular production build at `docker compose build` time (no nginx proxy —
# the frontend calls this URL directly from the browser). Must match BACKEND_PORT above.
API_BASE_URL=http://localhost:5000/api
