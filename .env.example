# Copy this file to .env and fill in real values before running docker-compose.
# Never commit the actual .env file.

# ---- PostgreSQL ----
POSTGRES_DB=taskmanager
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# ---- Backend (ASP.NET Core) ----
# Full connection string is assembled from the POSTGRES_* vars above in docker-compose.
ASPNETCORE_ENVIRONMENT=Production
BACKEND_PORT=5000

# JWT signing key: use a long, random, high-entropy secret (32+ bytes) in real deployments.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_ISSUER=TaskManager
JWT_AUDIENCE=TaskManagerClient
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# ---- Frontend ----
FRONTEND_PORT=4200
# Base URL the Angular app uses to call the API (adjust for your deployment).
API_BASE_URL=http://localhost:5000/api
