{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Db": ""
  },
  "Jwt": {
    "Issuer": "identity-service",
    "Audiences": [ "identity-service", "project-service", "task-service" ],
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "SigningKeyPath": "keys/identity-signing-key.pem"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
